# 請務必保持 UTF-8 編碼。
#
# 檔案名稱：環境變數範本
# 功能說明：複製本檔為 .env 後修改，即可覆寫設定檔中的對應項目，
#           不需直接改動 configs/app_config.yaml。
#           未設定的項目會使用設定檔中的預設值。
# 建立日期：2025-02-24

# 分析用的影像來源：影片檔路徑、攝影機編號（整數）或 RTSP / m3u8 串流網址
TRAFFIC_VIDEO_SRC=test_videos/test_video.mp4

# 道路區域座標設定檔
TRAFFIC_ROADS_INFO=configs/roads_polygons.json

# YOLO 權重檔路徑
TRAFFIC_WEIGHTS=weights/yolov8m.pt

# 所有執行結果的輸出根目錄
TRAFFIC_OUTPUT_DIR=outputs

# 畫面中文字型檔路徑（Windows 預設為微軟正黑體）
TRAFFIC_FONT_PATH=C:/Windows/Fonts/msjh.ttc
